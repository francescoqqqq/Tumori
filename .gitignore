# ===== nnU-Net – dati pesanti (raw, preprocessed, modelli) =====
# Si applica a qualsiasi sottocartella (clinico/, geometrica/, ecc.)
nnUNet_raw/
nnUNet_preprocessed/
nnUNet_results/

# ===== geometrica – contenuto esperimenti (generato a runtime) =====
# Dataset immagini generate
geometrica/experiments/*/1_dataset/
# Dati NIfTI e checkpoint modelli
geometrica/experiments/*/2_nnunet_engine/
# Predizioni PNG
geometrica/experiments/*/3_predizioni/
# Predizioni esterne (test.py modalità external)
geometrica/experiments/*/3_predizioni_ext/
# Visualizzazioni per-immagine (centinaia di PNG, troppo pesanti)
geometrica/experiments/*/4_confronto_finale/visualizations/
# Output estesi analisi esterna (contiene molte immagini)
geometrica/experiments/*/4_analisi_ext_*/
# In 4_confronto_finale ignora tutto, tranne il chart riepilogativo per test
geometrica/experiments/*/4_confronto_finale/*
!geometrica/experiments/*/4_confronto_finale/metrics_comparison_chart.png
# Log di esecuzione
geometrica/experiments/*/logs/

# File auto-generato da run_experiment.py a ogni run (deriva da config.py)
geometrica/geometric_config.py

# Vecchie cartelle pre-refactor (già eliminate, ignorate per sicurezza)
geometrica/dataset_shapes/
geometrica/dataset_shapes_one/
geometrica/confronto_results_*/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ===== Ambienti virtuali =====
venv/
env/
ENV/
.venv/

# ===== IDE / editor =====
.vscode/
.idea/
.claude/
*.swp
*.swo

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Log =====
*.log
training.log

# ===== File temporanei =====
*.tmp
*.temp

# ===== Dev container / VS Code Server (runtime, machine-specific) =====
# Dati runtime del server VS Code (estensioni, cache, sessioni, machine id):
# rigenerati automaticamente ad ogni avvio del devcontainer, mai da versionare.
.vscode-server/
.devcontainer/.onCreateCommandMarker
.devcontainer/.postCreateCommandMarker
.devcontainer/.postStartCommandMarker
.devcontainer/.updateContentCommandMarker

# ===== Credenziali / identità utente (MAI committare) =====
.ssh/
.gitconfig
.env
*.pem
*.key

# ===== Librerie GPU/driver copiate nel container (machine-specific) =====
/libcuda.so*
/libnvidia-ml.so*
